# Ejemplo de configuracion PostgreSQL (sin credenciales reales).
# Copia a .env y completa con valores locales. No commitees .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_bd
DB_USER=tu_usuario
DB_PASSWORD=tu_contrasena_segura

# URL efectiva construida por app/core/config.py:
# postgresql+psycopg2://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME
